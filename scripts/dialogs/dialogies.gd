extends Node

const LINES := {
	"blue": "— СИНИЙ стол? Где берут таких альтернативно одарённых?\n— Я сказал: НА КРАСНОМ!",
	"red": "ИНСТРУКЦИЯ 12-Б: A=04, Б=07, В=02; выключить канал обратной связи.",
	"welder": "Дверь намертво заварена... Какой хороший шов!",
	"teleport": "— Телепортации не существует! Это декорация для инвесторов!",
	"elevator_arrived": "ЛИФТ ПРИБЫЛ. Двери разблокированы. Подойдите к ним и нажмите [E].",
	"picked_up": "Получено: %s. Снабжение не подтверждает вашу личность.",
}

func t(id: String) -> String:
	if LINES.has(id):
		return LINES[id]
	push_warning("Нет реплики: " + id)
	return "[" + id + "]"
